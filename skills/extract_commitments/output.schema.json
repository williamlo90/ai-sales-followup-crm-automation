{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "Commitment": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "supersedes": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Supersedes"
        },
        "owner": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Owner",
          "type": "string"
        },
        "description": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "due_at": {
          "format": "date-time",
          "title": "Due At",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        },
        "state": {
          "default": "active",
          "enum": [
            "active",
            "cancelled"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "id",
        "revision",
        "owner",
        "description",
        "due_at",
        "observed_at",
        "evidence"
      ],
      "title": "Commitment",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "quote": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "revision",
        "quote"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Extraction": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "ready",
            "review"
          ],
          "title": "Status",
          "type": "string"
        },
        "commitments": {
          "items": {
            "$ref": "#/$defs/Commitment"
          },
          "maxItems": 20,
          "title": "Commitments",
          "type": "array"
        },
        "missing_information": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Missing Information",
          "type": "array"
        },
        "conflicts": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Conflicts",
          "type": "array"
        }
      },
      "required": [
        "status",
        "commitments",
        "missing_information",
        "conflicts"
      ],
      "title": "Extraction",
      "type": "object"
    },
    "Trace": {
      "additionalProperties": false,
      "properties": {
        "provider": {
          "enum": [
            "openai",
            "claude",
            "grok",
            "ollama"
          ],
          "title": "Provider",
          "type": "string"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "prompt_version": {
          "title": "Prompt Version",
          "type": "string"
        },
        "schema_version": {
          "title": "Schema Version",
          "type": "string"
        },
        "schema_hash": {
          "title": "Schema Hash",
          "type": "string"
        },
        "latency_ms": {
          "title": "Latency Ms",
          "type": "number"
        },
        "usage": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Usage",
          "type": "object"
        },
        "cost_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cost Usd"
        },
        "validation": {
          "enum": [
            "contract-double",
            "provider-response"
          ],
          "title": "Validation",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "ready",
            "review"
          ],
          "title": "Outcome",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "model",
        "prompt_version",
        "schema_version",
        "schema_hash",
        "latency_ms",
        "usage",
        "cost_usd",
        "validation",
        "outcome"
      ],
      "title": "Trace",
      "type": "object"
    }
  },
  "required": [
    "skill",
    "version",
    "result"
  ],
  "properties": {
    "skill": {
      "const": "extract_commitments"
    },
    "version": {
      "const": "1.0"
    },
    "result": {
      "additionalProperties": false,
      "properties": {
        "extraction": {
          "$ref": "#/$defs/Extraction"
        },
        "trace": {
          "$ref": "#/$defs/Trace"
        },
        "review_required": {
          "const": true,
          "title": "Review Required",
          "type": "boolean"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        }
      },
      "required": [
        "extraction",
        "trace",
        "review_required",
        "run_id"
      ],
      "title": "ExtractResult",
      "type": "object"
    }
  }
}
